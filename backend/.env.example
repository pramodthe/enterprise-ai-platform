# ============================================
# Enterprise AI Assistant Platform - Backend
# ============================================
# Copy to backend/.env and set OPENAI_API_KEY.

# LLM — key and base URL must match the same provider or you get 401.
#
# Fireworks (default when OPENAI_BASE_URL is omitted): create a key at
# https://fireworks.ai/account/api-keys — use it below; leave OPENAI_BASE_URL commented.
# Do not wrap the key in quotes unless the quotes are part of the key (they are not).
# You may use FIREWORKS_API_KEY instead of OPENAI_API_KEY if you prefer.
OPENAI_API_KEY=your_fireworks_or_openai_api_key_here
# OPENAI_BASE_URL=https://api.fireworks.ai/inference/v1
#
# OpenAI Platform instead: use an sk-... key and force the official API:
# OPENAI_BASE_URL=
# (empty value after = is required — do not delete the line)
# OPENAI_MODEL=gpt-4o-mini
OPENAI_MODEL=accounts/fireworks/models/minimax-m2p7
OPENAI_MAX_TOKENS=8192
OPENAI_TEMPERATURE=0.6
# Optional: alternate model if OPENAI_MODEL unset
# DEFAULT_MODEL=accounts/fireworks/models/minimax-m2p7

# Optional embeddings (OpenAI Platform); use if LLM key is Fireworks-only
# OPENAI_EMBEDDINGS_API_KEY=sk-...
# OPENAI_EMBEDDINGS_BASE_URL=

# CORS: comma-separated browser origins (production). Use * only for local/dev.
# Example (Cloud Run UI): CORS_ALLOW_ORIGINS=https://enterprise-ai-ui-xxxxx.run.app
# CORS_ALLOW_ORIGINS=*

# Optional HR tracing (Opik)
# ENABLE_TRACING=true
# OPIK_API_KEY=
# OPIK_WORKSPACE=
