# ============================================
# Enterprise AI Assistant Platform - Backend
# Environment Configuration Template
# ============================================

# ============================================
# OpenAI LLM Configuration (Primary Option)
# ============================================
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# ============================================
# Qdrant Vector Database
# ============================================
QDRANT_URL=https://<waiting-for-cluster-host>:6333
QDRANT_API_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJhY2Nlc3MiOiJtIn0.MHC_xSkuh8wgdbdodgB3JdkwQdQNUotkNTF6LCyW-wI
QDRANT_COLLECTION_NAME=documents

# ============================================
# Observability - Opik (Optional)
# ============================================
ENABLE_TRACING=false
OPIK_API_KEY=your_opik_api_key
OPIK_WORKSPACE=your_workspace_name

# ============================================
# Supabase Database (Optional)
# ============================================
SUPABASE_URL=your_supabase_url
SUPABASE_KEY=your_supabase_publishable_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ============================================
# Application Settings
# ============================================
DEFAULT_MODEL=gpt-4o-mini
MAX_TOKENS=1028
TEMPERATURE=0.3
DEBUG=False

# ============================================
# Database Configuration
# ============================================
DATABASE_URL=sqlite:///./enterprise_ai.db
CHROMA_DB_PATH=./chroma_db
EMPLOYEE_DATA_PATH=./data/employee_directory.csv

# ============================================
# Agent Configuration
# ============================================
EMPLOYEE_MCP_URL=http://localhost:8002/mcp/
EMPLOYEE_AGENT_URL=http://localhost:8001/
HR_AGENT_PORT=8000
ANALYTICS_MCP_URL=http://localhost:8003/mcp/

# ============================================
# Bedrock (Optional - embeddings only)
# ============================================
# AWS_ACCESS_KEY_ID=your_aws_access_key_here
# AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here
# AWS_DEFAULT_REGION=us-east-1
