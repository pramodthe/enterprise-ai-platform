# Copy to `.env.local` in this folder (or set vars in the repo root `.env` — Vite merges both).
# Restart `npm run dev` after changing env vars.
#
# Easiest local run: from this folder, `npm run dev:full` (starts Vite + Uvicorn together).

# Optional: dashboard header label (defaults: User / local@dev)
# VITE_APP_USER_NAME=Jane
# VITE_APP_USER_EMAIL=jane@example.com

# --- API ---
# Default: browser calls `/api/...` and Vite proxies to the FastAPI server.
# If the backend is not on 127.0.0.1:8000, set where to proxy (no /api suffix).
# Read from repo root `.env` or this folder — Vite merges both when resolving the proxy:
# VITE_PROXY_TARGET=http://127.0.0.1:8000
# BACKEND_URL=http://127.0.0.1:8000
# API_URL=http://127.0.0.1:8000

# Or bypass the proxy: full origin + /api (FastAPI mounts routers under /api/v1/...).
# If you omit the path, `/api` is appended automatically.
# VITE_API_BASE=http://127.0.0.1:8000/api
#
# If you open the UI as http://<LAN-IP>:3000, do not set VITE_API_BASE to 127.0.0.1 (the
# browser would call that host on the wrong machine). Leave it unset so Vite proxies /api.

# --- Autonomous LLM buyer (Arc_Marketplace) ---
# Browser calls POST {base}/demo/autonomous-llm-buyer/chat (example chat_server.py).
# Omit VITE_AUTONOMOUS_BUYER_CHAT_URL in dev to use same-origin /autonomous-buyer-proxy → 127.0.0.1:9095 (vite.config).
# VITE_AUTONOMOUS_BUYER_CHAT_URL=http://127.0.0.1:9095
# Vite dev only: where to proxy /autonomous-buyer-proxy (not exposed to the browser).
# VITE_AUTONOMOUS_BUYER_PROXY_TARGET=http://127.0.0.1:9095

# Backend secrets (OpenAI, etc.) belong in `backend/.env`, not here.
# Only variables prefixed with VITE_ are exposed to the browser.
